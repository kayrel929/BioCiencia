{
  "name": "biociencia",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "description": "BioCiencia – Plataforma Inteligente de Investigación Científica Colaborativa",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:web": "npm run dev -w @biociencia/web",
    "build:web": "npm run build -w @biociencia/web",
    "dev:desktop": "npm run tauri -w @biociencia/desktop -- dev",
    "build:desktop": "npm run tauri -w @biociencia/desktop -- build",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "app": "npm run build:web && node scripts/servir.mjs",
    "servir": "node scripts/servir.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
